# Sao chép file này thành .env rồi điền giá trị thật — .env KHÔNG được commit lên Git
#
# Mac dinh duoi day khop voi XAMPP MySQL mac dinh (user root, khong mat khau, port 3306).
# Neu ban dung XAMPP voi cau hinh goc thi KHONG can sua gi, chi can `cp .env.example .env` la chay duoc.
# Neu ban dung Docker Compose de chay MySQL rieng, doi DB_USERNAME/DB_PASSWORD sang gia tri trong muc MySQL ben duoi.

# ==== MySQL (chi dung khi chay MySQL qua docker-compose, khong dung neu ban dung XAMPP) ====
MYSQL_DATABASE=service_operations
MYSQL_USER=service_ops_user
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PORT=3306

# ==== Backend (Spring Boot) ====
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/service_operations
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=changeme_please_use_a_long_random_string
JWT_EXPIRATION=86400000
SERVER_PORT=8080

# ==== Frontend (React/Vite) ====
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Goc dia chi dat vao lien ket khoi phuc mat khau gui cho nguoi dung.
FRONTEND_BASE_URL=http://localhost:5173

# ==== Thu dien tu (khoi phuc mat khau) ====
#
# SMTP_HOST la cong tac: CO gia tri = gui thu that, o BAT KY profile nao.
#
#   SMTP_HOST rong  + profile dev  -> ghi lien ket ra log (logger AUDIT_MOCK_EMAIL)
#   SMTP_HOST rong  + profile prod -> backend DUNG KHOI DONG (co y, xem ben duoi)
#   SMTP_HOST co    + profile bat ky -> gui thu that qua SMTP
#
# Vi sao prod thieu SMTP_HOST thi phai dung khoi dong: neu de no len binh thuong,
# ung dung se im lang khong gui duoc thu trong khi giao dien van bao "da gui" —
# nguoi dung bi khoa ngoai ma khong ai biet cho toi khi co nguoi bao.
#
# --- Lay lien ket khi CHUA cau hinh SMTP (mac dinh) ---
#   docker logs service-ops-backend 2>&1 | grep AUDIT_MOCK_EMAIL | tail -1
# Neu chay backend truc tiep (khong qua Docker) thi xem thang o cua so console.
#
# --- Thu gui thu that tren may minh, khong can tai khoan SMTP nao ---
# Chay mot may chu thu cuc bo:
#   docker run -d -p 1025:1025 -p 8025:8025 --name mailhog mailhog/mailhog
# Roi dat:
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_AUTH=false
#   SMTP_STARTTLS=false
#   MAIL_FROM=no-reply@vanhanhdichvu.local
# Mo http://localhost:8025 de doc thu. Khoi dong lai backend truoc khi thu.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Mac dinh bat cho may chu thu that. Voi MailHog thi dat ca hai thanh false.
SMTP_AUTH=true
SMTP_STARTTLS=true

# Gioi han tan suat /auth/forgot-password (chan theo CA IP lan email)
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
