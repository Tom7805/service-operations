# Sao chép file này thành .env rồi điền giá trị thật — .env KHÔNG được commit lên Git
#
# Mac dinh duoi day khop voi XAMPP MySQL mac dinh (user root, khong mat khau, port 3306).
# Neu ban dung XAMPP voi cau hinh goc thi KHONG can sua gi, chi can `cp .env.example .env` la chay duoc.
# Neu ban dung Docker Compose de chay MySQL rieng, doi DB_USERNAME/DB_PASSWORD sang gia tri trong muc MySQL ben duoi.
#
# LUU Y VI TRI FILE: file nay danh cho kich ban chay qua DOCKER COMPOSE (`docker
# compose up` tu thu muc goc) — Docker tu doc `.env` o day de thay vao
# docker-compose.yml. Neu ban chay backend TRUC TIEP bang Maven (khong qua
# Docker: `cd backend && ./mvnw spring-boot:run`), dung `backend/.env.example`
# thay the — spring-dotenv doc file .env trong thu muc backend/, khong phai o day.

# ==== MySQL (chi dung khi chay MySQL qua docker-compose, khong dung neu ban dung XAMPP) ====
MYSQL_DATABASE=service_operations
MYSQL_USER=service_ops_user
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PORT=3306

# ==== Backend (Spring Boot) ====
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/service_operations
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=changeme_please_use_a_long_random_string
JWT_EXPIRATION=86400000
SERVER_PORT=8080

# ==== Frontend (React/Vite) ====
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Goc dia chi dat vao lien ket khoi phuc mat khau gui cho nguoi dung.
FRONTEND_BASE_URL=http://localhost:5173

# ==== Thu dien tu (khoi phuc mat khau) — TUY CHON o dev, BAT BUOC o prod ====
#
# Khong con la cong tac bat/tat toan cuc. He thong TU DONG quyet dinh gui that
# hay ghi log THEO TUNG DIA CHI EMAIL: tra ban ghi MX cua ten mien qua DNS
# truoc khi gui (xem backend DomainReachabilityChecker). Vi du, khi da dat
# SMTP_HOST ben duoi: gui toi @gmail.com/@outlook.com/domain cong ty se GUI
# THAT qua SMTP; gui toi cac tai khoan mau @service-operations.local van TU
# DONG ghi ra log — ten mien do khong ton tai that nen khong ton mot lan goi
# SMTP nao.
#
# O profile `dev`, de trong SMTP_HOST van chay binh thuong: MOI dia chi deu ghi
# ra log backend voi logger `AUDIT_MOCK_EMAIL`. Lay ma bang:
#     docker logs service-ops-backend 2>&1 | grep AUDIT_MOCK_EMAIL | tail -1
#
# O profile `prod`, thieu SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD/MAIL_FROM thi
# backend DUNG KHOI DONG. Day la CO Y: neu de rong, ung dung se len binh
# thuong roi im lang khong gui duoc thu that nao, trong khi giao dien van bao
# "da gui" — nguoi dung bi khoa ngoai ma khong ai biet cho toi khi co nguoi bao.
#
# THU RIENG TREN MAY MINH (khong lien quan Docker Compose nay): dung Gmail cua
# CHINH BAN, tu tao App Password rieng — xem backend/.env.example de biet cac
# buoc, roi chay `cd backend && ./mvnw spring-boot:run` thay vi Docker. App
# Password la bi mat CA NHAN — moi thanh vien trong team tu lam rieng tren
# Gmail cua chinh ho, khong chia se, khong dung chung mot tai khoan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Gioi han tan suat /auth/forgot-password (chan theo CA IP lan email)
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
