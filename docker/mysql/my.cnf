[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# Dat kich thuoc buffer pool theo RAM may chu (khoang 50-70% RAM danh cho MySQL).
innodb_buffer_pool_size = 512M
innodb_flush_log_at_trx_commit = 2
max_connections = 200
# Ghi lai truy van cham de phat hien diem nghen sau khi trien khai.
slow_query_log = 1
long_query_time = 1
