# Danh cho CHAY MAVEN TRUC TIEP (khong qua Docker): `cd backend && ./mvnw spring-boot:run`
#
# Sao chep file nay thanh `backend/.env` roi dien gia tri that.
# `backend/.env` KHONG duoc commit len Git (da khai bao trong .gitignore o thu
# muc goc — pattern `*.env` bat ca file nay).
#
# LUU Y VI TRI: neu ban chay qua Docker Compose (`docker compose up` tu thu muc
# goc), Docker doc `.env` o THU MUC GOC (`../.env` so voi file nay), KHONG PHAI
# file nay. Hai kich ban chay dung hai vi tri file .env khac nhau — xem
# `.env.example` o thu muc goc cho kich ban Docker. Neu ban khong chac dang
# chay kieu nao, doc README.md muc "Chay du an".

# ==== CSDL — khop XAMPP MySQL mac dinh. Neu dung Docker Compose cho MySQL rieng
# thi doi user/password cho khop cau hinh do. ====
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/service_operations
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=changeme_please_use_a_long_random_string
JWT_EXPIRATION=86400000
SERVER_PORT=8080

FRONTEND_BASE_URL=http://localhost:5173

# ==== Thu dien tu (khoi phuc mat khau) — TUY CHON, khong bat buoc de chay du an ====
#
# KHONG cau hinh gi (de trong SMTP_HOST): van chay binh thuong. Ma khoi phuc
# duoc ghi thang ra console khi ban bam "Quen mat khau" tren giao dien — du de
# code va kiem thu logic hang ngay, khong can lam gi them.
#
# Muon THU GUI THU THAT (vi du de demo): dung Gmail CUA RIENG BAN, khong dung
# chung voi ai trong team — moi nguoi tu tao App Password cua chinh minh:
#   1. myaccount.google.com/security -> bat "Xac minh 2 buoc" (neu chua bat)
#   2. myaccount.google.com/apppasswords -> tao mat khau ung dung moi
#   3. Dien vao day (KHONG dau cach giua cac ky tu)
#
# He thong TU DONG quyet dinh gui that hay ghi log THEO TUNG DIA CHI (tra ban
# ghi MX cua ten mien qua DNS) — khong can doi cau hinh qua lai. Vi du: mot khi
# ban dat SMTP_HOST duoi day, gui toi @gmail.com/@outlook.com/domain cong ty se
# GUI THAT; gui toi cac tai khoan mau @service-operations.local van TU DONG ghi
# ra console vi ten mien do khong ton tai that — khong ton mot lan goi SMTP nao.
#
# App Password la BI MAT CA NHAN — dung dan vao chat, khong commit, khong dua
# cho ai khac trong team. Moi nguoi tu lam rieng tren Gmail cua chinh ho.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=

# Gioi han tan suat /auth/forgot-password (chan theo CA IP lan email). Nang len
# khi dang thu di thu lai nhieu lan tren may minh, tranh dinh gioi han 5 lan/15
# phut mac dinh.
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
